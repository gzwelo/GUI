    private void btnCalculateActionPerformed(java.awt.event.ActionEvent evt) {                                             
        // TODO add your handling code here:

    // 1. score text field to 1d
    scores[0] = Double.parseDouble(txtJava.getText());
    scores[1] = Double.parseDouble(txtDatabase.getText());
    scores[2] = Double.parseDouble(txtNetworking.getText());
    scores[3] = Double.parseDouble(txtMath.getText());

    // 2. calculation meth shish
    double total = calculateTotal(scores);
    double average = calculateAverage(scores);
    double highest = findHighest(scores);
    double lowest = findLowest(scores);

    // 3. displat
    
    lblTotal.setText(String.valueOf(total));
    lblAverage.setText(String.format("%.2f", average));
    lblHighest.setText(String.valueOf(highest));
    lblLowest.setText(String.valueOf(lowest));

    // 4. lugic MAMAAAAAAAA
    if (average >= 75) {
        lblResult.setText("PASSED");
    } else {
        lblResult.setText("FAILED");
    }
    }                                            

